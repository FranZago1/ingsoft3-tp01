# Variables que consume docker-compose.yml. Copiar a .env y editar:
#
#     cp .env.example .env
#
# El .env NO se commitea (está en .gitignore). Este archivo sí, para que
# cualquiera sepa qué variables hacen falta sin tener que leer el compose.
# Si falta alguna, `docker compose up` corta con un mensaje que la nombra,
# en vez de levantar la app en un estado inseguro.

# Password del usuario `padel` de PostgreSQL. La usan el contenedor de la
# base y la DATABASE_URL que se le arma al backend.
DB_PASSWORD=cambiame-password-de-postgres

# Clave con la que el backend firma y verifica los JWT de sesión. Si cambia,
# todas las sesiones abiertas dejan de valer. En una entrega real esto sale
# de un gestor de secretos; acá, del .env que no se commitea.
# Generar una propia: openssl rand -hex 32
JWT_SECRET=cambiame-clave-larga-y-aleatoria
