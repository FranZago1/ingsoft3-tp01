# Conexión a PostgreSQL. Única fuente de verdad para la base de datos.
# Local (Postgres en Docker, ver docker-compose.yml):
DATABASE_URL="postgresql://padel:padel@localhost:5432/padel?schema=public"

# Secret para firmar los JWT. OBLIGATORIA: la app no arranca sin esto.
# En producción usar un valor largo y aleatorio.
JWT_SECRET="cambiame-por-un-secret-largo-y-aleatorio"
