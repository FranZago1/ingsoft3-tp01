# Variables que consume docker-compose.yml. Copiar a .env y editar:
#
#     cp .env.example .env
#
# El .env NO se commitea (está en .gitignore). Este archivo sí, para que
# cualquiera sepa qué variables hacen falta sin tener que leer el compose.

# Password del usuario `padel` de PostgreSQL. La usan el servicio `db` y la
# DATABASE_URL del backend. Cambiala por un valor propio.
DB_PASSWORD=cambiame-password-de-postgres

# Secret con el que se firman los JWT de sesión. El backend NO arranca sin esto.
# En producción: valor largo y aleatorio (ej: `openssl rand -base64 32`).
JWT_SECRET=cambiame-por-un-secret-largo-y-aleatorio

# Zona horaria de los containers. Importa: las reglas de horario (08:00–23:00)
# y "sin reservas en el pasado" se evalúan con la hora local del backend.
TZ=America/Argentina/Cordoba
