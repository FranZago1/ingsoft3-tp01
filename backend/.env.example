# Solo para correr el backend NATIVO (npm run dev), fuera de Docker.
# Con docker compose estas variables las inyecta el compose y este archivo no
# se usa. Copiar a backend/.env (no se commitea).

# Única fuente de conexión a la base. Prohibido hardcodearla en el código.
# Apunta al Postgres del compose publicado en localhost:5432.
DATABASE_URL="postgresql://padel:cambiame-password-de-postgres@localhost:5432/padel?schema=public"

# Obligatoria: el backend falla al arrancar si no está.
JWT_SECRET="secret-de-desarrollo-no-usar-en-produccion"

# Opcional, default 8080.
PORT=8080
